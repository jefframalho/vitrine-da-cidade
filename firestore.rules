rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Quem pode cadastrar, editar e excluir lojas.
    // Para dar acesso a outra pessoa, acrescente o e-mail dela na lista.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email in ['jeffersonramalhopb@gmail.com'];
    }

    // Lojas: qualquer visitante lê, só o admin escreve
    match /lojas/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Fotos e PDFs das lojas
    match /midias/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
  }
}
